            "final_answer": "\\text{当 } a<-1 \\text{ 时 } \\{x|x<-\\frac{1}{a} \\text{ 或 } x>1\\}; \\text{ 当 } a=-1 \\text{ 时 } \\{x|x \\ne 1\\}; \\text{ 当 } -1<a<0 \\text{ 时 } \\{x|x<1 \\text{ 或 } x>-\\frac{1}{a}\\}; \\text{ 当 } a=0 \\text{ 时 } \\{x|x<1\\}; \\text{ 当 } a>0 \\text{ 时 } \\{x|-\\frac{1}{a}<x<1\\}",
